---
import BaseLayout from '../layouts/BaseLayout.astro';

const gameLines = [
  {
    name: 'Luciphilus',
    kicker: 'Paid adventurer escort',
    role: 'An adventurer, escort, and monster-clearer accepts contracts, clears threats, escorts fragile travelers, fights bosses, and recovers relics.',
    cast: 'Current roster: Swordsman L1-L9, Female Mage Level 1-9, Male Mage Level 1-9, and the actual Priest sprite route. Female Mage Levels 1-3 use Mage4 and Levels 4-9 use Mage3; Male Mage Levels 1-3 use Mage2 and Levels 4-9 use Mage1. Mage overlays start at Level 3, Level 8 is the dragon-eye glyph, and Level 9 keeps the final grand magic aura. Priest now uses the finalized healer overlay ladder from healing mote through winged holy grail.',
    fantasy: 'You carry the light into the road after someone else has found it.',
    contributes: ['Cleared routes', 'Boss relics', 'Monster parts', 'Recovered weapons', 'Proof an area can be rebuilt']
  },
  {
    name: 'Tenebrio',
    kicker: 'Shriner transformation route',
    role: 'A weak shriner maps forbidden routes and survives through rites, maps, disguise, transformation, and forbidden knowledge.',
    cast: 'Current roster: bare male unarmed, bare male armed, Imp 1-3, Lich 1-3, and the selected Mage Tower ritual-demon final form.',
    fantasy: 'You are weak, but you know the rites.',
    contributes: ['Map fragments', 'Shrine keys', 'Disguise rites', 'Occult warnings', 'Route unlocks']
  },
  {
    name: 'Opiphilus',
    kicker: 'Guild crafter / monk route',
    role: 'A guild worker, crafter, monk, or trade traveler is fragile outside settlements, posts escort requests, travels for shops and craft jobs, and rebuilds civilization.',
    cast: 'Current roster: product-defined Smith Level 0 base plus Levels 1-9 overlays, Herbalist Level 0 base plus Levels 1-9 overlays, and Monk Level 1-9 progression on the Mon1k body. Smith Level 1 uses a small floating flame; Smith Levels 2-3 use a no-shield straight-handle Thor-style hammer mark and clear flame; Smith and Herbalist Levels 4-8 use emblem-only badges; Smith Level 5 reads as a flame badge; Herbalist Levels 1-3 build from one to three flapping butterflies and badge levels retain two off-shield butterflies. Monk Level 1 uses one lit candle, Level 2 uses two candles, Levels 3-7 use candle, Bible, lantern, olive-branch, and vow-vessel badges, and Levels 8-9 use the final radiant and thick halo treatments. Smith and Herbalist Level 9 are companion-only, using a flying forge bat for Smith and a flying garden bird for Herbalist.',
    fantasy: 'You make the tools that let the town endure the abyss.',
    contributes: ['Road lanterns', 'Shrine repair kits', 'Guild orders', 'Town upgrades', 'Market circulation']
  }
];

const currentRoster = [
  {
    game: 'Luciphilus',
    route: 'Swordsman, Mage, and Priest routes',
    entries: [
      'Swordsman L1-L9',
      'Female Mage Level 1-9: Mage4 body at Levels 1-3, Mage3 body at Levels 4-9, with overlays from Level 3 through the final Level 9 grand magic aura',
      'Male Mage Level 1-9: Mage2 body at Levels 1-3, Mage1 body at Levels 4-9, with the same overlay ladder from Level 3 through Level 9',
      'Actual Priest sprite route with finalized healer overlays from healing mote through winged holy grail'
    ]
  },
  {
    game: 'Tenebrio',
    route: 'Shriner transformation route',
    entries: [
      'Level 1: bare male unarmed',
      'Level 2: bare male armed',
      'Levels 3-5: Imp 1-3',
      'Levels 6-8: Lich 1-3',
      'Level 9: Mage Tower ritual demon, stable support/materialization frames 7-13'
    ]
  },
  {
    game: 'Opiphilus',
    route: 'Guild craft and monk route',
    entries: [
      'Smith Level 0 base plus Levels 1-9 always-visible overlays: floating flame, no-shield straight-handle Thor-style hammer mark, clear flame, then hammer, flame, anvil, master anvil, and grand forge badges, ending with a flying forge bat companion-only Level 9',
      'Herbalist Level 0 base plus Levels 1-9 always-visible overlays: one, two, then three flapping butterflies, followed by leaf, vial, mortar, bloom, and grand bloom badges with two off-shield butterflies, ending with a flying garden bird companion-only Level 9',
      'Monk Level 1-9 progression on the Mon1k body: one lit candle, two candles, candle badge, Bible badge, lantern badge, olive-branch badge, vow-vessel badge, radiant halo, and thick halo; Mon2k, Mon3k, and Mon4k remain support/reference variants'
    ]
  }
];

const handoff = [
  'Luciphilus clears the first route threat and brings back a relic-crystal shard.',
  'Tenebrio recovers a map fragment from a room that appears only under a Road-Bound disguise.',
  'Opiphilus combines recovered relics, iron, glasswork, and craft labor into route hardware.',
  'The shrine-town hub repairs the route marker, issues a road charter, and reveals the ruins gate.'
];

const forces = [
  {
    name: 'Shrine Orders',
    claim: 'Rites, names, road markers, and disguise customs decide who the road recognizes.'
  },
  {
    name: 'Lantern Companies',
    claim: 'Expeditions prove whether a recovered route can actually be survived.'
  },
  {
    name: 'Guild Houses',
    claim: 'Workshops turn relics, glass, iron, and charters into civic infrastructure.'
  },
  {
    name: 'Crystal Courts',
    claim: 'Old gates, archives, checkpoints, and inscriptions still enforce failed road law.'
  },
  {
    name: 'Road-Bound',
    claim: 'Some monsters are displaced guardians, cursed citizens, or territorial dead, not simple invaders.'
  }
];
---

<BaseLayout
  title="Games | Via Occulta"
  description="The three linked Via Occulta game lines: Luciphilus fights, Tenebrio transforms, and Opiphilus builds."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Three linked game lines</p>
      <h1>Discovery, battle, and craft share one wounded map.</h1>
      <p>
        Via Occulta is not one generic online role with different skins. Luciphilus, Tenebrio, and
        Opiphilus are distinct ways of serving the same hidden-road world: fight through what guards
        it, learn the rites that reveal it, and rebuild the civic systems that keep it open.
      </p>
      <div class="pill-row">
        <span class="pill">Luciphilus fights</span>
        <span class="pill">Tenebrio transforms</span>
        <span class="pill">Opiphilus builds</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Playable lenses</p>
      <h2>The world changes when each role completes its part.</h2>
      <div class="role-grid">
        {gameLines.map((line) => (
          <article class="role-card panel">
            <p class="card-kicker">{line.kicker}</p>
            <h3>{line.name}</h3>
            <p>{line.role}</p>
            <p class="role-card__quote">{line.fantasy}</p>
            <h4>Cast anchor</h4>
            <p>{line.cast}</p>
            <h4>Contributes</h4>
            <ul>
              {line.contributes.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell">
      <p class="eyebrow">Current playable roster</p>
      <h2>Three routes, now cast as concrete level lines.</h2>
      <div class="card-grid">
        {currentRoster.map((line) => (
          <article class="info-card panel">
            <p class="card-kicker">{line.game}</p>
            <h3>{line.route}</h3>
            <ul>
              {line.entries.map((entry) => <li>{entry}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell">
      <p class="eyebrow">One road, five claims</p>
      <h2>The route is never just a dungeon entrance.</h2>
      <div class="force-grid">
        {forces.map((force) => (
          <article class="info-card panel">
            <h3>{force.name}</h3>
            <p>{force.claim}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div class="summary-panel panel">
        <p class="eyebrow">Core loop</p>
        <h3>Find the road. Survive the road. Rebuild the road.</h3>
        <ul>
          <li>Luciphilus clears the combat threat inside the revealed dungeon, ruin, cave, or under-route.</li>
          <li>Tenebrio discovers a hidden shrine route, forbidden door, monster disguise, or map fragment.</li>
          <li>Opiphilus builds the tools, repairs, recipes, charms, and guild infrastructure needed to hold it open.</li>
          <li>The world unlocks a new room, road, recipe, project, or story chapter.</li>
        </ul>
      </div>
      <div class="prose">
        <p>
          Shrine-town hubs, guild halls, market squares, and restoration projects give the world continuity,
          while dungeons, story rooms, shrine trials, and key battles stay focused and readable.
        </p>
        <p>
          This is why the setting is built around infrastructure instead of conquest. A route is not saved when a monster dies. It is saved when the shrine remembers the rite, the adventurers prove the danger can be survived, and the guild can make the repaired key, lantern, marker, or charter work again.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Opening handoff</p>
      <h2>The first chapter proves the whole shared-world promise.</h2>
      <div class="chapter-flow">
        {handoff.map((step, index) => (
          <article class="chapter-step panel" data-step={`0${index + 1}`}>
            <h3>{index === 0 ? 'Expedition' : index === 1 ? 'Rite' : index === 2 ? 'Repair' : 'Unlock'}</h3>
            <p>{step}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
